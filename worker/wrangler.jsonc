{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "shiratsume-garden",
  "main": "index.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "shiratsume-garden-private"
    }
  ]
  // Enable comments by creating a D1 database, applying migrations and adding:
  // "d1_databases": [{
  //   "binding": "DB", "database_name": "shiratsume-garden-comments",
  //   "database_id": "YOUR_DATABASE_ID", "migrations_dir": "migrations"
  // }]
  // PUBLIC_SITE_ORIGINS optionally adds comma-separated website origins for comments.
  // Set ADMIN_PASSWORD and SESSION_SECRET with `wrangler secret put`.
  // Optional server Text variable ADMIN_USERNAME changes the default Amubis account.
  // SESSION_SECRET must contain at least 32 random characters. Never add secrets here.
  // Keep this bucket private; public derivatives are served only through /media/.
}
